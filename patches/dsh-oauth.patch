diff --git a/packages/llm/llm-pi-ai/src/oauth-store.ts b/packages/llm/llm-pi-ai/src/oauth-store.ts
new file mode 100644
index 0000000000..10eb4cc993
--- /dev/null
+++ b/packages/llm/llm-pi-ai/src/oauth-store.ts
@@ -0,0 +1,105 @@
+/**
+ * Adapter between the Harness credential-reference seam and pi-ai's typed
+ * OAuth credential store. The Harness store deliberately remains string-based;
+ * this bridge serializes one provider-scoped pi-ai credential as JSON under a
+ * derived, hidden reference and never exposes its value to the UI.
+ */
+
+import { credentialRef } from '@deepseek-ai/dsh-credentials'
+import type { CredentialProvider } from '@deepseek-ai/dsh-credentials'
+import type {
+  Credential,
+  CredentialInfo,
+  CredentialStore,
+} from '@earendil-works/pi-ai'
+
+/** A provider id mapped to a valid Harness credential reference. */
+export function oauthCredentialRef(provider: string): ReturnType<typeof credentialRef> {
+  const suffix = provider.toUpperCase().replace(/[^A-Z0-9]+/g, '_')
+  return credentialRef(`PI_OAUTH_${suffix}`)
+}
+
+function parseCredential(value: string | undefined): Credential | undefined {
+  if (value === undefined) return undefined
+  try {
+    const parsed: unknown = JSON.parse(value)
+    if (typeof parsed !== 'object' || parsed === null) return undefined
+    const record = parsed as Record<string, unknown>
+    if (record.type === 'oauth') {
+      if (typeof record.access !== 'string' || typeof record.refresh !== 'string' || typeof record.expires !== 'number') {
+        return undefined
+      }
+      return record as Credential
+    }
+    if (record.type === 'api_key') {
+      if (record.key !== undefined && typeof record.key !== 'string') return undefined
+      return record as Credential
+    }
+  } catch {
+    // A malformed credential is treated as absent; pi-ai will report the
+    // provider as unconfigured and the user can log in again.
+  }
+  return undefined
+}
+
+/**
+ * Persistent CredentialStore used by the pi-ai Models collection. Writes are
+ * serialized per provider so token refresh and interactive login cannot race.
+ */
+export class DshPiCredentialStore implements CredentialStore {
+  private readonly chains = new Map<string, Promise<void>>()
+  private readonly known = new Set<string>()
+
+  constructor(private readonly source: CredentialProvider | undefined) {}
+
+  async read(providerId: string): Promise<Credential | undefined> {
+    this.known.add(providerId)
+    if (this.source === undefined) return undefined
+    const hit = await this.source.resolve(oauthCredentialRef(providerId))
+    return parseCredential(hit?.value)
+  }
+
+  async list(): Promise<readonly CredentialInfo[]> {
+    const entries: CredentialInfo[] = []
+    for (const providerId of this.known) {
+      const credential = await this.read(providerId)
+      if (credential !== undefined) entries.push({ providerId, type: credential.type })
+    }
+    return entries
+  }
+
+  async modify(
+    providerId: string,
+    fn: (current: Credential | undefined) => Promise<Credential | undefined>,
+  ): Promise<Credential | undefined> {
+    this.known.add(providerId)
+    const previous = this.chains.get(providerId) ?? Promise.resolve()
+    let resolveTail!: () => void
+    const tail = new Promise<void>(resolve => { resolveTail = resolve })
+    const queued = previous.then(() => tail, () => tail)
+    this.chains.set(providerId, queued)
+    await previous
+    try {
+      const current = await this.read(providerId)
+      const next = await fn(current)
+      // pi-ai uses undefined from modify as "leave unchanged".
+      if (next !== undefined) {
+        if (this.source === undefined) throw new Error('DSH credential service is unavailable')
+        await this.source.set(oauthCredentialRef(providerId), JSON.stringify(next))
+      }
+      return next ?? current
+    } finally {
+      resolveTail()
+      if (this.chains.get(providerId) === queued) this.chains.delete(providerId)
+    }
+  }
+
+  async delete(providerId: string): Promise<void> {
+    this.known.add(providerId)
+    if (this.source === undefined) return
+    await this.modify(providerId, async () => {
+      await this.source!.unset(oauthCredentialRef(providerId))
+      return undefined
+    })
+  }
+}
