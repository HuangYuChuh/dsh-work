+import { describe, expect, it } from 'vitest'
+import type { CredentialProvider } from '@deepseek-ai/dsh-credentials'
+import { PiAiAdapter } from '../src/adapter.ts'
+import { DshPiCredentialStore, oauthCredentialRef } from '../src/oauth-store.ts'
+
+function fakeSource(): { provider: CredentialProvider; values: Map<string, string> } {
+  const values = new Map<string, string>()
+  const provider = {
+    resolve: async (ref: string) => {
+      const value = values.get(ref)
+      return value === undefined ? undefined : { value, source: 'file' }
+    },
+    set: async (ref: string, value: string) => { values.set(ref, value) },
+    unset: async (ref: string) => { values.delete(ref) },
+  } as unknown as CredentialProvider
+  return { provider, values }
+}
+
+describe('pi-ai OAuth credential bridge', () => {
+  it('serializes OAuth credentials under a provider-scoped DSH reference', async () => {
+    const source = fakeSource()
+    const store = new DshPiCredentialStore(source.provider)
+    const ref = oauthCredentialRef('openai-codex')
+    const credential = { type: 'oauth' as const, access: 'access-token', refresh: 'refresh-token', expires: 123 }
+
+    await store.modify('openai-codex', async () => credential)
+
+    expect(source.values.get(ref)).toBe(JSON.stringify(credential))
+    expect(await store.read('openai-codex')).toEqual(credential)
+    await store.delete('openai-codex')
+    expect(source.values.has(ref)).toBe(false)
+    expect(await store.read('openai-codex')).toBeUndefined()
+  })
+
+  it('keeps concurrent writes ordered per provider', async () => {
+    const source = fakeSource()
+    const store = new DshPiCredentialStore(source.provider)
+    const first = store.modify('openai-codex', async () => ({
+      type: 'oauth' as const, access: 'a', refresh: 'r1', expires: 1,
+    }))
+    const second = store.modify('openai-codex', async current => ({
+      type: 'oauth' as const, access: 'b', refresh: current?.type === 'oauth' ? current.refresh : 'r2', expires: 2,
+    }))
+
+    await Promise.all([first, second])
+
+    expect(await store.read('openai-codex')).toEqual({
+      type: 'oauth', access: 'b', refresh: 'r1', expires: 2,
+    })
+  })
+
+  it('reports dormant OAuth providers without exposing a token', async () => {
+    const source = fakeSource()
+    const store = new DshPiCredentialStore(source.provider)
+    const adapter = new PiAiAdapter({
+      profiles: () => new Map(),
+      resolveApiKey: async () => undefined,
+      credentials: store,
+    })
+
+    await expect(adapter.authStatus('openai-codex')).resolves.toMatchObject({
+      provider: 'openai-codex',
+      oauth: true,
+      apiKey: false,
+      configured: false,
+    })
+
+    await store.modify('openai-codex', async () => ({
+      type: 'oauth' as const, access: 'access-token', refresh: 'refresh-token', expires: 123,
+    }))
+    await expect(adapter.authStatus('openai-codex')).resolves.toMatchObject({
+      provider: 'openai-codex',
+      configured: true,
+      source: 'OAuth',
+    })
+  })
+})
